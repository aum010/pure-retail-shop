# ─────────────────────────────────────────────────────────────────────────────
# Payment server configuration (read by server/config.ts).
#
# Nothing here is bundled into the browser — only VITE_* vars reach the client.
# Copy this file to `.env` to override the built-in defaults.
# ─────────────────────────────────────────────────────────────────────────────

# How payments are processed (also overridable with `--mode=…`):
#
#   mock     Local simulator only. Nothing reaches eSewa or Khalti, so you can
#            exercise every path offline. The checkout page itself shows each
#            wallet's sign-in form with the test credentials as placeholders, so
#            payment completes in place with no redirect, plus one-click buttons
#            for Pending / Failed / Cancel. (default)
#
#   sandbox  Real gateway test environments.
#            · eSewa  works out of the box — no merchant account needed, it
#                     signs with the public EPAYTEST secret against
#                     rc-epay.esewa.com.np.
#            · Khalti falls back to mock unless KHALTI_SECRET_KEY is set (see
#                     below), since sandbox keys are issued per merchant.
#
#   live     Real money. Refuses to start unless real credentials are set and
#            ESEWA_ENV / KHALTI_ENV are both "production".
PAYMENTS_MODE=mock

# Where the React app runs. Used as the CORS origin, and as a fallback for
# gateway return URLs when PUBLIC_APP_URL is unset.
CLIENT_ORIGIN=http://localhost:8080

# Pins the origin gateways redirect back to, and the one Khalti is told to
# associate with the payment. Set it for any deployment.
#
# Leave it unset in development and return URLs will follow the address the
# shopper actually used — so browsing from a phone at http://192.168.1.42:8080
# redirects back there instead of to localhost. Must be HTTPS in production.
# PUBLIC_APP_URL=https://shop.example.com

# Port the payment API listens on (Vite proxies /api here in development).
PORT=3001

# Set to true to have the API also serve the built SPA from ./dist.
SERVE_CLIENT=false

# ── eSewa ────────────────────────────────────────────────────────────────────
# "test" (default) hits rc-epay.esewa.com.np, "production" hits epay.esewa.com.np.
# Note: the old uat.esewa.com.np host no longer resolves.
ESEWA_ENV=test
# Merchant ID / product code. The public sandbox merchant is EPAYTEST.
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_PRODUCT_CODE=EPAYTEST
# Public UAT secret published in eSewa's docs — adequate for "sandbox".
# Replace with the key eSewa issues you before going live.
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Where the payment API stores orders. SQLite needs no server or credentials:
# one file, backed up as a unit, and readable with any SQL client. The path is
# relative to the project root; the directory is created on first boot.
# Point it at PostgreSQL or MySQL instead by swapping the driver in
# server/orderStore.ts — every query already lives in one file.
DATABASE_URL=data/orders.db

# ── Khalti ───────────────────────────────────────────────────────────────────
# "sandbox" (default) uses dev.khalti.com; "production" uses khalti.com.
KHALTI_ENV=sandbox
# live_secret_key from https://test-admin.khalti.com (sandbox) or
# https://admin.khalti.com (production).
#
# Leave empty to run Khalti through the local simulator in sandbox mode.
# Required for PAYMENTS_MODE=live.
KHALTI_SECRET_KEY=

# ── Client (safe to expose; contains no secrets) ─────────────────────────────
# Base URL the browser uses for API calls. Leave as /api to use the Vite
# dev proxy; set an absolute URL if the API is hosted separately.
VITE_API_BASE=/api

# Khalti PUBLIC key (not the secret key) — enables the in-page checkout widget
# so shoppers pay without leaving the site. Safe to embed: it cannot move money
# on its own, and every payment is still verified server-side with KHALTI_SECRET_KEY.
# Get it from your Khalti merchant dashboard (test-admin.khalti.com in sandbox).
# Leave blank to fall back to the redirect checkout.
# VITE_KHALTI_PUBLIC_KEY=test_public_key_dc74e0fd57cb46cd93832aee0a507256

# ─────────────────────────────────────────────────────────────────────────────
# Sandbox test credentials (for exercising the gateways manually):
#   eSewa — ID 9711111111, password Test@123, MPIN 1122
#   Khalti — ID 9800000000, MPIN 1111, OTP 987654
#
# Switching PAYMENTS_MODE to "live" requires real ESEWA_SECRET_KEY and
# KHALTI_SECRET_KEY to be set; the server refuses to start with the sandbox
# defaults in live mode.
# ─────────────────────────────────────────────────────────────────────────────
